# #109: function → affected test file(s) for `deputy test --changed`.
# Format:  <function-name>: <test_basename> [<test_basename>...]   (basename = tests/test_<x>.sh)
# A changed function selects its listed tests. A changed `cmd_<X>` also AUTO-maps to
# `test_<X>` by convention when tests/test_<X>.sh exists (no entry needed for those).
# FAIL-SAFE: any changed function with NO mapping (not here + no convention match), any
# top-level (non-function) change, or any unknown non-doc file change → the FULL suite runs.
# Keep this current when a helper's test coverage moves; a stale entry only costs an extra
# full-suite run (never a silent skip).

# ── commands whose tests are not simply test_<name> ──────────────────────────
cmd_list: test_list test_list_detail test_cmd_help
cmd_watch: test_watch_digest test_livelog test_reflect test_review
cmd_add: test_add test_add_priority test_autorun test_worker_proposal
cmd_run: test_run test_run_add test_run_priority test_run_branch_guard test_heartbeat test_headed
cmd_reflect: test_reflect test_review
cmd_pick: test_pick

