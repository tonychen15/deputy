# Deputy per-repo config. KEY=VALUE, one per line.
test_cmd=
lint_cmd=
build_cmd=
# max_items: items started per run cycle. Default/minimum 1 (one tick = one item) so a
# single autonomous tick can't drain + merge the whole queue unsupervised. There is NO
# unbounded mode: 0/empty/invalid clamps to 1. Set an explicit N for a multi-item drain.
max_items=1
time_cap_mins=30
heartbeat_mins=10
human_backoff=1
human_idle_grace_mins=5
# waiting_backoff_strikes: a session reporting the (undocumented) 'waiting' status must
# hold it for this many consecutive heartbeat ticks before cron proceeds (cautious: a
# transient mid-tool 'waiting' can't survive N ticks). Default 3.
waiting_backoff_strikes=3
# orphan_warn_mins: on each run, deputy WARNS (never kills) about a bash process running
# longer than this many minutes under an in-repo interactive Claude session — a likely
# leaked background command that can pin the session busy and stall the heartbeat. Default 30.
orphan_warn_mins=30
# auto_merge: allow a spawned (headless) worker to git-merge its branch to the default
# branch. Default 0 — the guardrail BLOCKS the merge and the worker must SURFACE the branch
# for a human to review and merge. Set 1 only if you trust autonomous merges.
auto_merge=0
# notify_on_spawn: announce (notification + a prominent cron.log "===SPAWN===" line)
# every time the heartbeat autonomously spawns a worker, so an unattended pickup is never
# silent. Default 1 (on). Set 0 to silence. Interactive runs never fire it.
notify_on_spawn=1
# sandbox: wrap the headless worker in a bwrap read-only sandbox so it cannot write to
# the repo CODE (only .deputy/, BACKLOG.md, and the .deputy/wt worktree are writable; the
# rest of the filesystem is normal). Default 1 (on; requires bwrap). 0 = cwd-pin only.
sandbox=1
